{
  "name": "bead-belt",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Bead Belt — головоломка с шариками и конвейером (Capacitor, Android)",
  "scripts": {
    "validate": "node tools/validate-levels.mjs",
    "simulate": "node tools/simulate.mjs",
    "test": "npm run validate && npm run simulate && npm run version:check",
    "dev": "npx --yes serve www -l 5173",
    "bump": "node scripts/bump-version.mjs",
    "bump:sync": "node scripts/bump-version.mjs --sync",
    "version:check": "node scripts/bump-version.mjs --check",
    "android:init": "node scripts/init-android.mjs",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "node scripts/init-android.mjs && cd android && ./gradlew assembleDebug assembleRelease",
    "assets": "npx capacitor-assets generate --android",
    "check:android": "node scripts/check-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/app": "latest",
    "@capacitor/core": "latest",
    "@capacitor/haptics": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
